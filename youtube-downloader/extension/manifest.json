{
  "manifest_version": 3,
  "name": "YouTube Downloader (yt-dlp)",
  "version": "1.0.0",
  "description": "دانلود ویدیو و صدا از یوتیوب با کیفیت دلخواه، با استفاده از yt-dlp روی کامپیوتر خودتان",
  "key": "",
  "permissions": ["nativeMessaging"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "YouTube Downloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
