{
  "manifest_version": 3,
  "name": "Telegram Video Downloader",
  "version": "1.0.0",
  "description": "دانلود ویدیوها از گروه‌ها و کانال‌های تلگرام (شامل گروه‌های خصوصی) در Telegram Web",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Telegram Video Downloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
