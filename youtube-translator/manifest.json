{
  "manifest_version": 3,
  "name": "YouTube Live Translator",
  "version": "1.0.0",
  "description": "زیرنویس فارسی همزمان برای ویدیوهای یوتیوب (ترجمهٔ خودکار زیرنویس) با امکان خواندن صوتی ترجمه",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://edge.microsoft.com/*",
    "https://api-edge.cognitive.microsofttranslator.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "YouTube Live Translator",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
